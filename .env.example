# Copy to .env for local development. Never commit .env.
# In production (Render), set these as environment variables instead.

# --- Core -------------------------------------------------------------
DJANGO_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Old keys still accepted while rotating DJANGO_SECRET_KEY (comma-separated)
DJANGO_SECRET_KEY_FALLBACKS=
# Full origins allowed to POST forms, e.g. https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (local; Render uses DATABASE_URL) -----------------------
DB_NAME=furniture
DB_USER=furniture
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Email --------------------------------------------------------------
# Console backend prints emails in the terminal. For real email use:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sam's Stunning Furniture <no-reply@example.com>

# --- Production hardening (only used when DJANGO_DEBUG=False) ----------
# Proxies in front of the app that append to X-Forwarded-For (see docs/authentication.md)
DJANGO_TRUSTED_PROXY_COUNT=0
DJANGO_BEHIND_HTTPS_PROXY=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Retention -----------------------------------------------------------
ACCOUNTS_SECURITY_EVENT_RETENTION_DAYS=90
